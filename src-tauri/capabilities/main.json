{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-trusted",
  "description": "Grants the herness application commands to the single trusted local main webview. No remote URL is registered and no other window or preview webview is included.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-ui-ready",
    "allow-open-project",
    "allow-list-projects",
    "allow-select-project",
    "allow-project-view",
    "allow-add-connection",
    "allow-list-connections",
    "allow-save-api-key",
    "allow-start-chatgpt-login",
    "allow-cancel-chatgpt-login",
    "allow-chatgpt-login-status",
    "allow-start-run",
    "allow-stop-run",
    "allow-resume-run",
    "allow-poll-project",
    "allow-snapshot",
    "allow-history",
    "allow-approve",
    "allow-deny",
    "allow-frontend-state"
  ]
}
