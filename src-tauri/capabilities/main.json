{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-trusted",
  "description": "Grants the herness application commands to the single trusted local main webview. No remote URL is registered and no other window or preview webview is included.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-ui-ready",
    "allow-open-project",
    "allow-list-projects",
    "allow-select-project",
    "allow-project-view",
    "allow-add-connection",
    "allow-list-connections",
    "allow-save-api-key",
    "allow-start-chatgpt-login",
    "allow-cancel-chatgpt-login",
    "allow-chatgpt-login-status",
    "allow-chatgpt-models",
    "allow-set-connection-model",
    "allow-start-run",
    "allow-stop-run",
    "allow-resume-run",
    "allow-poll-project",
    "allow-snapshot",
    "allow-history",
    "allow-approve",
    "allow-deny",
    "allow-supervision-create",
    "allow-supervision-list",
    "allow-supervision-get",
    "allow-supervision-start",
    "allow-supervision-stop",
    "allow-supervision-cancel",
    "allow-supervision-resume",
    "allow-supervision-reassess",
    "allow-supervision-change",
    "allow-supervision-profile",
    "allow-supervision-verify-profile",
    "allow-supervision-consent",
    "allow-supervision-evidence",
    "allow-supervision-budget",
    "allow-supervision-recovery",
    "allow-html-sync-state",
    "allow-html-sync-history",
    "allow-html-sync-budget",
    "allow-html-sync-barrier",
    "allow-html-sync-approve",
    "allow-html-sync-enable",
    "allow-html-sync-pause",
    "allow-html-sync-cancel",
    "allow-html-sync-resume",
    "allow-html-sync-reassess",
    "allow-html-sync-resolve-conflict",
    "allow-html-sync-restore",
    "allow-frontend-state",
    "allow-quit-app",
    "allow-quit-state",
    "allow-quit-choice"
  ]
}
